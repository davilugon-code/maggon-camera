# LiveSnap Environment Configuration

# Public Base URL (Change to your domain or local IP when sharing on Wi-Fi e.g. http://192.168.1.100:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage Driver: 'local' | 's3' | 'supabase'
STORAGE_DRIVER=local

# Local Storage Directory (defaults to ./public/uploads)
LOCAL_UPLOAD_PATH=./public/uploads

# Supabase PostgreSQL Configuration
# 1. Execute the SQL script in `supabase/schema.sql` in your Supabase SQL Editor
# 2. Paste your project URL and keys below:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AWS S3 Storage Config (Optional - enabled when STORAGE_DRIVER=s3)
AWS_REGION=us-east-1
AWS_S3_BUCKET=livesnap-photos
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
